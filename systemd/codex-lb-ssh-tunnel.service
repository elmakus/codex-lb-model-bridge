[Unit]
Description=Encrypted loopback tunnel to Codex-LB
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/bin/ssh -F /dev/null -N -T -o BatchMode=yes -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no -o PubkeyAuthentication=yes -o IdentitiesOnly=yes -o IdentityFile=__CODEX_LB_SSH_IDENTITY__ -o UserKnownHostsFile=%h/.ssh/known_hosts -o GlobalKnownHostsFile=/dev/null -o StrictHostKeyChecking=yes -o UpdateHostKeys=no -o VerifyHostKeyDNS=no -o HostKeyAlgorithms=ssh-ed25519 -o AddressFamily=inet -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o TCPKeepAlive=yes -o RequestTTY=no -o ForwardAgent=no -o ForwardX11=no -o PermitLocalCommand=no -o ControlMaster=no -o GatewayPorts=no -o LogLevel=ERROR -L 127.0.0.1:__CODEX_LB_TUNNEL_PORT__:127.0.0.1:__CODEX_LB_REMOTE_PORT__ __CODEX_LB_SSH_USER__@__CODEX_LB_SSH_HOST__
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
KillMode=mixed
Environment=HOME=%h
LimitCORE=0
LimitNOFILE=256
TasksMax=16

NoNewPrivileges=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
UMask=0077
InaccessiblePaths=-%h/.codex -%h/.local/share/keyrings
IPAddressDeny=any
IPAddressAllow=localhost
IPAddressAllow=__CODEX_LB_SSH_HOST__/32

[Install]
WantedBy=graphical-session.target
